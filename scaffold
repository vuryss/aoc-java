#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

interface_file="$(find . -type f -path '*/src/main/java/*/SolutionInterface.java')"

if [[ -z "$interface_file" || "$interface_file" == *$'\n'* ]]; then
    printf '%s\n' 'Expected exactly one SolutionInterface.java' >&2
    exit 1
fi

source_root="${interface_file%%/src/main/java/*}/src/main/java"

./gradlew :app:shadowJar

exec java --enable-native-access=ALL-UNNAMED \
    -jar app/build/libs/app-all.jar \
    scaffold --source-root "$source_root" "$@"